{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctv-ai-intelligent-surveillance.local/schemas/person_detected.json",
  "title": "Person Detected Event",
  "description": "Event generated when the person detection agent detects one or more people in a CCTV frame.",
  "allOf": [
    {
      "$ref": "base_event.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "person.detected"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_id",
            "detections"
          ],
          "properties": {
            "frame_id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique identifier of the processed video frame."
            },
            "detections": {
              "type": "array",
              "description": "People detected in the frame.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "detection_id",
                  "confidence",
                  "bbox"
                ],
                "properties": {
                  "detection_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Unique identifier for this detection within the event."
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Model confidence score."
                  },
                  "bbox": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    },
                    "description": "Bounding box in [x1, y1, x2, y2] format."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}