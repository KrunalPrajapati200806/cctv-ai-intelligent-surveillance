# Application
APP_ENV=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cctv
POSTGRES_USER=cctv_user
POSTGRES_PASSWORD=change_me

# Frontend
FRONTEND_PORT=5173

# Detection
DETECTION_CONFIDENCE=0.5

# Tracking
TRACKING_MAX_AGE=30

# Behavior
LOITERING_THRESHOLD_SECONDS=30
RUNNING_SPEED_THRESHOLD=5.0

# Crowd
CROWD_DENSITY_THRESHOLD=10

# Restricted Area
RESTRICTED_AREA_ENABLED=true