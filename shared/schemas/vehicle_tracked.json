{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctv-ai-intelligent-surveillance.local/schemas/vehicle_tracked.json",
  "title": "Vehicle Tracked Event",
  "description": "Event generated by the tracking agent when a detected vehicle is assigned or updated with a persistent tracking ID.",
  "allOf": [
    {
      "$ref": "base_event.json"
    },
    {
      "type": "object",
      "properties": {
        "event_type": {
          "const": "vehicle.tracked"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frame_id",
            "tracks"
          ],
          "properties": {
            "frame_id": {
              "type": "string",
              "minLength": 1,
              "description": "Identifier of the processed video frame."
            },
            "tracks": {
              "type": "array",
              "description": "Tracked vehicles visible in the current frame.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "track_id",
                  "detection_id",
                  "class",
                  "bbox",
                  "confidence"
                ],
                "properties": {
                  "track_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Persistent identifier assigned to the vehicle by the tracking system."
                  },
                  "detection_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Detection identifier associated with this track."
                  },
                  "class": {
                    "type": "string",
                    "enum": [
                      "car",
                      "motorcycle",
                      "bus",
                      "truck",
                      "bicycle",
                      "van"
                    ],
                    "description": "Vehicle category."
                  },
                  "bbox": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number"
                    },
                    "description": "Current bounding box in [x1, y1, x2, y2] format."
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Tracking or associated detection confidence."
                  },
                  "center": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    },
                    "description": "Center point of the bounding box in [x, y] format."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}